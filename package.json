{
  "name": "sequelize-zod",
  "version": "1.0.0",
  "description": "Type-safe Zod validation for Sequelize model attributes",
  "author": "Mattia Malonni",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "keywords": [
    "sequelize",
    "sequelize-plugin",
    "sequelize-extension",
    "zod",
    "validation",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mattiamalonni/sequelize-zod.git"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --out-dir dist --clean --sourcemap && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && npm run lint && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check && npm run test:coverage && npm run build"
  },
  "peerDependencies": {
    "sequelize": "^6",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
